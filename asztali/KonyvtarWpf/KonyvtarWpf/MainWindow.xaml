<Window x:Class="KonyvtarWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KonyvtarWpf"
        mc:Ignorable="d"
        Title="Könyvtárkezelő alkalmazás" Height="450" Width="600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="BooksListBox" Grid.Row="1" Margin="5" DisplayMemberPath="DisplayText" SelectionMode="Single">
            
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
            <Button x:Name="AddButton" Content="Új könyv hozzáadása" Width="150" Height="30" Margin="5" Click="AddButton_Click"/>
            <Button x:Name="DeleteButton" Content="Törlés" Width="100" Height="30" Margin="5" Click="DeleteButton_Click"/>
        </StackPanel>

        <Border x:Name="InputPanel" Grid.Row="1" Margin="5" Visibility="Hidden">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Cím:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
                <TextBox x:Name="TitleTextBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="300" Height="18" Margin="5"/>

                <TextBlock Text="Szerző:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
                <TextBox x:Name="AuthorTextBox" Grid.Row="1" Grid.Column="1" Width="300" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="18" Margin="5"/>

                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="10">
                    <Button x:Name="SaveButton" Content="Mentés" Width="80" Height="25" Margin="5" Click="SaveButton_Click"/>
                    <Button x:Name="CancelButton" Content="Mégsem" Width="80" Height="25" Margin="5" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>