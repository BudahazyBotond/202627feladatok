<Window x:Class="SzepsegGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SzepsegGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="320" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Label FontSize="14" Margin="5,0,0,0" Content="Kérem, válasszon szakmát!" />
            <ComboBox x:Name="cb_szakma" Height="25" Margin="5,0,5,0" SelectionChanged="cb_szakma_SelectionChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Label x:Name="l_alk" FontSize="14" Margin="5,0,0,0" Content="Kérem, válasszon alkalmazottat!" IsEnabled="False" />
            <ComboBox x:Name="cb_alk" Height="25" Margin="5,0,5,0" IsEnabled="False" SelectionChanged="cb_alk_SelectionChanged"/>
        </StackPanel>
        <GroupBox Grid.Row="2" Margin="10" FontSize="14" Header="Az alkalmazott telefonszáma">
            <TextBox BorderThickness="0" x:Name="tb_tel" IsReadOnly="True"/>
        </GroupBox>
    </Grid>
</Window>
