<Window x:Class="SzepsegWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SzepsegWPF"
        mc:Ignorable="d"
        Title="Szépségszalon - Alkalmazottak adatai" Height="325" Width="505">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="4.5*"></RowDefinition>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <Label x:Name="l_szakma" Margin="15,0,0,0" FontSize="15" VerticalAlignment="Center" DockPanel.Dock="Top">Kérem, válasszon szakmát!</Label>
            <ComboBox x:Name="cb_szakma" DockPanel.Dock="Bottom" Margin="10,5,10,5"/>
        </DockPanel>
        <DockPanel Grid.Row="1">
            <Label x:Name="l_alkalmazott" Margin="15,0,0,0" FontSize="15" VerticalAlignment="Center" DockPanel.Dock="Top">Kérem, válasszon szakmát!</Label>
            <ComboBox x:Name="cb_alkalmazott" DockPanel.Dock="Bottom" Margin="10,5,10,5"/>
        </DockPanel>
        <GroupBox FontSize="15" Header="Az alkalmazott telefonszáma" Grid.Row="2" Margin="10,15,10,15">
            <TextBox IsReadOnly="True" BorderThickness="0" x:Name="tb_tel" />
        </GroupBox>
    </Grid>
</Window>
