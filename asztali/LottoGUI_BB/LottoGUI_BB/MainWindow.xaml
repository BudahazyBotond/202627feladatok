<Window x:Class="LottoGUI_BB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LottoGUI_BB"
        mc:Ignorable="d"
        Title="Lottosorsolas" Height="600" Width="500" MinWidth="400" MinHeight="450">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Játékmód" Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="rb_otos" Content="ötös" Grid.Column="0" Margin="10" Checked="GameType_Checked"/>
                <RadioButton x:Name="rb_hatos" Content="hatos" Grid.Column="1" Margin="10" Checked="GameType_Checked"/>
                <RadioButton x:Name="rb_skandinav" Content="skandináv" Grid.Column="2" Margin="10" Checked="GameType_Checked"/>
            </Grid>
        </GroupBox>

        <Grid x:Name="g_nums" Grid.Row="1">
            
        </Grid>

        <Button x:Name="btn_sorsolas" Grid.Row="2" Content="Sorsolás" Width="80" Height="20" HorizontalAlignment="Left" IsEnabled="False" Click="SorsolasButton_Click" Margin="20,0,0,10" VerticalAlignment="Bottom"/>

        <StackPanel x:Name="sp_kihuzott" Grid.Row="3" Orientation="Horizontal" Margin="20,1,1,1" Visibility="Hidden" >
            <TextBlock Text="A kihúzott számok: " FontWeight="Bold" FontSize="12"/>
            <TextBlock x:Name="tb_kihuzott" FontSize="12"/>
        </StackPanel>

        <StackPanel x:Name="sp_talalat" Grid.Row="4" Orientation="Horizontal" Margin="20,1,1,1" Visibility="Hidden">
            <TextBlock Text="Találatok száma: " FontWeight="Bold" FontSize="12"/>
            <TextBlock x:Name="tb_talalatok" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
