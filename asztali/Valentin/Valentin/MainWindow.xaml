<Window x:Class="Valentin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Valentin"
        mc:Ignorable="d"
        Title="Groind" Height="570" Width="400"
        Background="LightPink">
    
    <DockPanel>
        <Border Background="MediumPurple" DockPanel.Dock="Top" Height="40" Margin="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Groind regisztrálás" Foreground="Black" FontSize="16"/>
            </StackPanel>
        </Border>
        <Border Background="MediumPurple" DockPanel.Dock="Bottom" Height="50" Width="380" Margin="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Készítette: Budaházy Botond" Foreground="Black" FontSize="16"/>
            </StackPanel>
        </Border>
        <Border Background="MediumPurple" DockPanel.Dock="Left" Height="400" Width="80" Margin="10" CornerRadius="5">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="REKLÁM" Foreground="Black" FontSize="16">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Border>
        <Border Background="MediumPurple" DockPanel.Dock="Right" Height="400" Width="80" Margin="10" CornerRadius="5">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="REKLÁM" Foreground="Black" FontSize="16">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </StackPanel>
        </Border>
        <Border Background="MediumPurple" Height="400" Margin="10" CornerRadius="5">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="10">
                <Label Foreground="Black" FontSize="14" HorizontalAlignment="Center">Felhsználónév:</Label>
                <TextBox Width="160" Margin="0,5,0,15"/>

                <Label Foreground="Black" FontSize="14" HorizontalAlignment="Center">Jelszó:</Label>
                <PasswordBox Width="160" Margin="0,5,0,15"/>
                <GroupBox Header="Nem" Foreground="Black" Margin="10,0,0,5" Width="59" HorizontalAlignment="Left">
                    <StackPanel>
                        <RadioButton Content="Férfi" Foreground="Black" FontSize="14" Margin="0,0,0,5"/>
                        <RadioButton Content="Nő" Foreground="Black" FontSize="14" Margin="0,0,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Keres" Foreground="Black" Margin="10,0,0,5" Width="63" HorizontalAlignment="Left">
                    <StackPanel>
                        <RadioButton Content="Férfit" Foreground="Black" FontSize="14" Margin="0,0,0,5"/>
                        <RadioButton Content="Nőt" Foreground="Black" FontSize="14" Margin="0,0,0,0"/>
                    </StackPanel>
                </GroupBox>
                <Button Content="Regisztráció" Width="100" Height="30" Margin="0,30,0,0" Background="Pink" Foreground="Black"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
