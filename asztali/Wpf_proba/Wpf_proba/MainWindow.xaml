<Window x:Class="Wpf_proba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_proba"
        mc:Ignorable="d"
        Title="ElsőWPF" Height="450" Width="800">
    <Canvas>
        <Button x:Name="gomb" Content="Nay Gigger" Canvas.Left="350" Canvas.Top="100" Height="50" Width="100" Background="PaleVioletRed" BorderBrush="Red" Foreground="White" Click="gomb_Click"/>
        <ListBox x:Name="listadoboz" Height="100" Width="200" d:ItemsSource="{d:SampleData ItemCount=4}" Canvas.Left="300" Canvas.Top="200"/>

    </Canvas>
</Window>
